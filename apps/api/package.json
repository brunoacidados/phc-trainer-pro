{
  "name": "@phc/api",
  "version": "6.4.0",
  "private": true,
  "type": "module",
  "description": "API multiutilizador do PHC Trainer Pro — Express 5 + Mongoose + JWT + router de IA no servidor.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mongo:dev": "node scripts/dev-mongo.mjs",
    "rag:seed": "tsx scripts/seed-rag.ts"
  },
  "dependencies": {
    "@phc/content": "workspace:*",
    "@phc/shared": "workspace:*",
    "@sentry/node": "^10.75.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "zod": "^4.6.5",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "mongodb-memory-server": "^11.2.0"
  }
